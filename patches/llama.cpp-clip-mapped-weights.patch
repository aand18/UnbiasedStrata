+// UnbiasedStrata experiment (GGML_CUDA_CLIP_MAPPED=1): zero-copy weights. Host-pinned
+// memory mapped into the device address space; tensor->data holds the DEVICE pointer
+// (kernels) while the host pointer backs CPU-side access. Reuses the device buffer
+// interface: its set/get use explicit H2D/D2H kinds, which the driver honors for mapped
+// pointers. Single GPU (device 0), like the host type above.
+struct ggml_backend_cuda_mapped_buffer_context {
+    int device;
+    void * dev_ptr;
+    void * host_ptr;
+};
+
+static const char * ggml_backend_cuda_mapped_buffer_type_get_name(ggml_backend_buffer_type_t buft) {
+    GGML_UNUSED(buft);
+    return "CUDA_Mapped_Host";
+}
+
+static void ggml_backend_cuda_mapped_buffer_free_buffer(ggml_backend_buffer_t buffer) {
+    ggml_backend_cuda_mapped_buffer_context * ctx = (ggml_backend_cuda_mapped_buffer_context *) buffer->context;
+    CUDA_CHECK(cudaFreeHost(ctx->host_ptr));
+    delete ctx;
+}
+
+static void * ggml_backend_cuda_mapped_buffer_get_base(ggml_backend_buffer_t buffer) {
+    ggml_backend_cuda_mapped_buffer_context * ctx = (ggml_backend_cuda_mapped_buffer_context *) buffer->context;
+    return ctx->dev_ptr;
+}
+
+static const ggml_backend_buffer_i ggml_backend_cuda_mapped_buffer_interface = {
+    /* .free_buffer     = */ ggml_backend_cuda_mapped_buffer_free_buffer,
+    /* .get_base        = */ ggml_backend_cuda_mapped_buffer_get_base,
+    /* .init_tensor     = */ ggml_backend_cuda_buffer_init_tensor,
+    /* .memset_tensor   = */ ggml_backend_cuda_buffer_memset_tensor,
+    /* .set_tensor      = */ ggml_backend_cuda_buffer_set_tensor,
+    /* .get_tensor      = */ ggml_backend_cuda_buffer_get_tensor,
+    /* .set_tensor_2d   = */ ggml_backend_cuda_buffer_set_tensor_2d,
+    /* .get_tensor_2d   = */ ggml_backend_cuda_buffer_get_tensor_2d,
+    /* .cpy_tensor      = */ ggml_backend_cuda_buffer_cpy_tensor,
+    /* .clear           = */ ggml_backend_cuda_buffer_clear,
+    /* .reset           = */ NULL,
+};
+
+static ggml_backend_buffer_t ggml_backend_cuda_mapped_buffer_type_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    ggml_cuda_set_device(0);
+
+    void * host_ptr = nullptr;
+    CUDA_CHECK(cudaHostAlloc(&host_ptr, size, cudaHostAllocMapped));
+    void * dev_ptr = nullptr;
+    CUDA_CHECK(cudaHostGetDevicePointer(&dev_ptr, host_ptr, 0));
+
+    ggml_backend_cuda_mapped_buffer_context * ctx = new ggml_backend_cuda_mapped_buffer_context{0, dev_ptr, host_ptr};
+
+    return ggml_backend_buffer_init(buft, ggml_backend_cuda_mapped_buffer_interface, ctx, size);
+}
+
+ggml_backend_buffer_type_t ggml_backend_cuda_mapped_buffer_type() {
+    static struct ggml_backend_buffer_type ggml_backend_cuda_buffer_type_mapped = {
+        /* .iface    = */ {
+            /* .get_name         = */ ggml_backend_cuda_mapped_buffer_type_get_name,
+            /* .alloc_buffer     = */ ggml_backend_cuda_mapped_buffer_type_alloc_buffer,
+            /* .get_alignment    = */ ggml_backend_cuda_buffer_type_get_alignment,
+            /* .get_max_size     = */ NULL, // defaults to SIZE_MAX
+            /* .get_alloc_size   = */ ggml_backend_cuda_buffer_type_get_alloc_size,
+            /* .is_host          = */ NULL, // not host: like device bufts, takes the H2D upload path
+        },
+        /* .device   = */ ggml_backend_reg_dev_get(ggml_backend_cuda_reg(), 0),
+        /* .context  = */ nullptr,
+    };
+
+    return &ggml_backend_cuda_buffer_type_mapped;
+}
+
+static bool ggml_backend_buft_is_cuda_mapped(ggml_backend_buffer_type_t buft) {
+    return buft->iface.get_name == ggml_backend_cuda_mapped_buffer_type_get_name;
+}
+
